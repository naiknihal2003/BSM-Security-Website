# ---------------------------------------------------------------------------
# Enquiry delivery
#
# Enquiries from the Request Security drawer and the contact page form are
# emailed server-side through Resend (https://resend.com). Nothing is ever
# reported to the visitor as sent unless Resend accepts the message.
#
# Until RESEND_API_KEY and ENQUIRY_FROM_EMAIL are both set, /api/enquiry
# returns 501 and the form says plainly that the enquiry was NOT delivered,
# pointing the visitor at the phone / email / WhatsApp routes instead.
# ---------------------------------------------------------------------------

# Server-only API key from the Resend dashboard. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address. Must be on a domain verified with Resend,
# e.g. "BSM Security <enquiries@bsmsecurityagency.com>".
ENQUIRY_FROM_EMAIL=

# Where enquiries are delivered.
ENQUIRY_TO_EMAIL=contact@bsmsecurityagency.com

# Optional fallback, used only when the Resend variables above are not set:
# any endpoint accepting a JSON POST (a CRM, or a Slack/Teams incoming webhook).
ENQUIRY_WEBHOOK_URL=
